  function openPanel(title,body,type,wide=false){lastFocus=document.activeElement;activePanel=type;el('panelTitle').textContent=title;el('panelBody').innerHTML=body;el('panel').classList.toggle('wide',wide);el('panel').scrollTop=0;el('overlay').hidden=false;document.body.classList.add('lock');el('closePanel').focus()}
