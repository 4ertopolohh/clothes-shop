}
.admin-meta {
  font-size: 10px;
  color: #7d7b73;
  margin-bottom: 15px;
}
.admin-orders li {
  border-bottom: 1px solid var(--line);
  padding: 14px 0;
  line-height: 1.8;
  font-size: 12px;
}
.reveal {
  opacity: 1;
  transform: none;
}
.motion .reveal:not(.visible) {
  opacity: 0;
  transform: translateY(22px);
}
.motion .reveal {
  transition:
    opacity 0.7s var(--ease),
    transform 0.7s var(--ease);
}
@media (max-width: 1050px) {
