                  </span>
                </div>
                <div className={cx("cart-row", "total")}>
                  <span>Итого</span>
                  <span>{fmt(quote.total)}</span>
                </div>
                {quote.delivery_days && (
                  <p className={cx("field-hint")}>{quote.delivery_days}</p>
                )}
              </>
            )
          )}
        </aside>
      </div>
    </section>
  );
}
