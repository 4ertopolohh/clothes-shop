              !!quoteError ||
              !city ||
              (method === "pickup" && !point)
            }
          >
            {busy && <Spinner />}
            {busy ? "Оформляем заказ…" : "Оформить заказ"}
          </button>
          <p className={cx("checkout-note")}>
            Проверим доступность вещей и сохраним заказ. К оплате можно будет
