      </div>
    </section>
    <section class="editorial shell" id="manifesto" aria-labelledby="manifestoTitle"><div class="editorial-copy reveal"><div class="small-cap">О концепции</div><div><h2 id="manifestoTitle">Меньше шума.<br>Больше смысла.</h2><p>Наша визуальная идея — одежда без лишнего декора, в которой качество силуэта говорит громче логотипа. Это демонстрационное позиционирование будущего бренда.</p><a href="#catalog">Посмотреть коллекцию</a></div></div><div class="editorial-image"><img src="https://images.unsplash.com/photo-1701450707728-dc66fd42da83?auto=format&fit=crop&w=1200&q=82" alt="Модель в строгом чёрном костюме на тёмном фоне" loading="lazy"></div></section>
    <section class="delivery-section shell" id="delivery" aria-labelledby="deliveryTitle"><div class="reveal"><h2 id="deliveryTitle">Покупки без<br>лишних шагов.</h2><p>Выбирайте вещь, размер и цвет. Добавляйте покупки в корзину, используйте промокод и указывайте удобный пункт выдачи. В этом макете весь путь можно пройти без регистрации.</p><p>В рабочем магазине условия оплаты, сроки и тарифы доставки будут зависеть от подключённых сервисов и согласованного ТЗ.</p></div><div class="details-list reveal"><article><strong>Подбор размера</strong><p>Размер и цвет выбираются отдельно для каждой вещи и сохраняются в корзине.</p></article><article><strong>Доставка СДЭК</strong><p>В демонстрации доступны города и пункты выдачи. Реальная интеграция и тарифы требуют API СДЭК.</p></article><article><strong>Оплата онлайн</strong><p>Оформление заказа моделируется без перевода средств и без обращения к платёжному провайдеру.</p></article><article><strong>Сервис и контакты</strong><p>Для публикации магазина заказчик предоставит юридические данные, условия возврата и контакты поддержки.</p></article></div></section>
  </main>
  <footer class="footer" id="contacts"><div class="shell"><div class="footer-upper"><div><div class="footer-brand">ATELIER NOIR</div><p class="footer-brand-sub">Одежда, свободная от лишнего.</p></div><div class="footer-col"><h3>Магазин</h3><a href="#catalog">Коллекция</a><a href="#manifesto">О концепции</a><a href="#delivery">Доставка и оплата</a><a href="#top">В начало</a></div><div class="footer-col"><h3>Демонстрация</h3><button id="openAdmin">Открыть демо-админку</button><button data-open-search>Поиск товаров</button><button id="footerCart">Моя корзина</button></div></div><div class="footer-bottom"><span>© 2026 ATELIER NOIR · Дизайн-концепция, не действующий магазин</span><span>Фото: <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>. Перед публикацией замените материалы фотографиями бренда.</span></div></div></footer>
  <div class="overlay" id="overlay" hidden><div class="panel" id="panel" role="dialog" aria-modal="true" aria-label="Панель магазина"><div class="panel-head"><h2 id="panelTitle"></h2><button id="closePanel" class="close-btn" aria-label="Закрыть панель">Закрыть</button></div><div class="panel-body" id="panelBody"></div></div></div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
  'use strict';
  const PHOTO = id => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=920&q=82`;
  const seed = [
    ['Пальто «Линия»','Верхняя одежда',32900,'photo-1515886657613-9f3515b0c78f','Чёрный,Графит','XS,S,M,L','Новая форма', 'Удлинённое пальто с чистыми линиями и свободной посадкой.'],
    ['Жакет «Контур»','Верхняя одежда',18900,'photo-1701450707728-dc66fd42da83','Чёрный,Графит','S,M,L,XL','', 'Жакет прямого силуэта для выразительного многослойного образа.'],
    ['Куртка «Тень»','Верхняя одежда',21500,'photo-1630046108712-43875343a84f','Чёрный,Молочный','XS,S,M,L','Новинка', 'Лаконичная куртка с объёмной линией плеча.'],
    ['Лонгслив «Такт»','Трикотаж',7900,'photo-1616570993271-d9d56f8933a7','Чёрный,Графит,Молочный','XS,S,M,L,XL','', 'Базовый лонгслив для повседневных сочетаний.'],
    ['Топ «Пауза»','Трикотаж',6400,'photo-1628038341191-8e7448fc8209','Чёрный,Молочный','XS,S,M,L','', 'Простой силуэт и мягкое прилегание.'],
    ['Брюки «Объём»','Брюки',14800,'photo-1539109136881-3be0616acf4b','Чёрный,Графит','S,M,L,XL','Новинка', 'Широкие брюки с мягкой линией складок.'],
    ['Рубашка «Поле»','Рубашки',11900,'photo-1551938032-eb735ff04051','Молочный,Чёрный','XS,S,M,L','', 'Свободная рубашка для многослойного гардероба.'],
    ['Пиджак «Архив»','Верхняя одежда',27900,'photo-1529139574466-a303027c1d8b','Чёрный,Графит','S,M,L,XL','', 'Пиджак с точной архитектурой силуэта.'],
    ['Футболка «База»','Футболки',4900,'photo-1621694691319-0d74e2d9a79c','Чёрный,Молочный,Графит','XS,S,M,L,XL','', 'Лаконичная футболка свободной посадки.'],
    ['Платье «Тишина»','Платья',15900,'photo-1541130292430-a832637ddc0d','Чёрный,Молочный','XS,S,M,L','Новинка', 'Струящийся силуэт для спокойного выразительного образа.'],
    ['Бомбер «Облако»','Верхняя одежда',24500,'photo-1554412933-514a83d2f3c8','Чёрный,Графит','XS,S,M,L,XL','', 'Объёмная форма и лаконичная отделка.'],
    ['Брюки «Вектор»','Брюки',12900,'photo-1483985988355-763728e1935b','Чёрный,Молочный','XS,S,M,L,XL','', 'Повседневные брюки со свободным кроем.'],
    ['Туника «Слой»','Трикотаж',8900,'photo-1525507119028-ed4c629a60a3','Чёрный,Молочный','S,M,L','', 'Удлинённая форма для многослойных сочетаний.'],
    ['Рубашка «Свет»','Рубашки',10900,'photo-1490481651871-ab68de25d43d','Молочный,Графит','XS,S,M,L','', 'Рубашка с мягкой структурой ткани.'],
    ['Топ «Ритм»','Трикотаж',6900,'photo-1533836683024-78f6568c4ce1','Чёрный,Графит','XS,S,M,L','', 'Комфортный топ для ежедневного гардероба.'],
    ['Пальто «Пластика»','Верхняя одежда',35900,'photo-1487222477894-8943e31ef7b2','Графит,Чёрный','S,M,L','', 'Выразительный объём и сдержанная отделка.']
  ];
  const COLOR_MAP = {'Чёрный':'#171717','Графит':'#57585a','Молочный':'#e3dfd3','Песочный':'#b9a99b'};
  const SIZE_LIST=['XS','S','M','L','XL','XXL'];
  const fmt = value => Number(value).toLocaleString('ru-RU')+' ₽';
  const escapeHTML = value => String(value??'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const getSaved = (key, fallback) => {try{const raw=localStorage.getItem(key);return raw===null?fallback:JSON.parse(raw)}catch{return fallback}};
  const save = (key,value) => {try{localStorage.setItem(key,JSON.stringify(value))}catch{}};
  const defaults = seed.map((a,i)=>({id:'p'+(i+1),name:a[0],category:a[1],price:a[2],image:PHOTO(a[3]),colors:a[4].split(','),sizes:a[5].split(','),badge:a[6],description:a[7],rank:i}));
  let products=getSaved('an_demo_products_v1',defaults);
  if(!Array.isArray(products)||!products.length)products=[...defaults];
  let cart=getSaved('an_demo_cart_v1',[]).filter(item=>products.some(p=>p.id===item.id));
  let orders=getSaved('an_demo_orders_v1',[]);
  let filters={categories:new Set(),sizes:new Set(),colors:new Set(),max:40000,query:'',sort:'featured'};
  let displayedCount=9, selectedProduct=null,selectedColor=null,selectedSize=null,selectedQty=1, promo='', activePanel='',lastFocus=null,toastTimer;
  const el=id=>document.getElementById(id);
  const byId=id=>products.find(p=>p.id===id);
  const categories=()=>[...new Set(products.map(p=>p.category))];
  const maxPrice=()=>Math.max(40000,Math.ceil(Math.max(0,...products.map(p=>p.price))/1000)*1000);
  const productCard=p=>`<article class="product-card reveal"><button class="product-photo" data-product="${escapeHTML(p.id)}" aria-label="Подробнее: ${escapeHTML(p.name)}"><img src="${escapeHTML(p.image)}" alt="Демонстрационное фото: ${escapeHTML(p.name)}" loading="lazy" onerror="this.style.opacity='.2';this.alt='Фото недоступно'"><span class="quick-view">Посмотреть вещь</span>${p.badge?`<span class="product-badge">${escapeHTML(p.badge)}</span>`:''}</button><div class="product-meta"><button class="product-name" data-product="${escapeHTML(p.id)}">${escapeHTML(p.name)}</button><div class="product-category">${escapeHTML(p.category)}</div><div class="product-bottom"><span class="product-price">${fmt(p.price)}</span><span class="mini-swatches" aria-label="Цвета: ${escapeHTML(p.colors.join(', '))}">${p.colors.map(c=>`<i style="background:${COLOR_MAP[c]||'#aaa'}" title="${escapeHTML(c)}"></i>`).join('')}</span></div></div></article>`;
  function renderFilters(){
    el('categoryFilters').innerHTML=categories().map(c=>`<label class="check-row"><input type="checkbox" data-cat="${escapeHTML(c)}" ${filters.categories.has(c)?'checked':''}>${escapeHTML(c)}</label>`).join('');
    el('sizeFilters').innerHTML=SIZE_LIST.map(s=>`<button class="size-pill ${filters.sizes.has(s)?'active':''}" data-size-filter="${s}" aria-pressed="${filters.sizes.has(s)}">${s}</button>`).join('');
    el('colorFilters').innerHTML=Object.keys(COLOR_MAP).map(c=>`<button class="color-choice ${filters.colors.has(c)?'active':''}" data-color-filter="${c}" aria-label="Цвет: ${c}" aria-pressed="${filters.colors.has(c)}"><span class="swatch" style="background:${COLOR_MAP[c]}"></span></button>`).join('');
    const top=maxPrice();el('priceRange').max=top;if(filters.max>top)filters.max=top;el('priceRange').value=filters.max;el('rangeTopLabel').textContent=fmt(top);el('priceMaxLabel').textContent='до '+fmt(filters.max);
  }
  function filteredProducts(){let out=products.filter(p=>(!filters.categories.size||filters.categories.has(p.category))&&(!filters.sizes.size||p.sizes.some(s=>filters.sizes.has(s)))&&(!filters.colors.size||p.colors.some(c=>filters.colors.has(c)))&&p.price<=filters.max&&(!filters.query||(p.name+' '+p.category+' '+p.description).toLowerCase().includes(filters.query.toLowerCase())));if(filters.sort==='price-asc')out.sort((a,b)=>a.price-b.price);else if(filters.sort==='price-desc')out.sort((a,b)=>b.price-a.price);else if(filters.sort==='new')out.sort((a,b)=>Number(!!b.badge)-Number(!!a.badge)||a.rank-b.rank);else out.sort((a,b)=>a.rank-b.rank);return out}
  function renderCatalog(){const list=filteredProducts(),show=list.slice(0,displayedCount);el('resultCount').textContent=`${list.length} ${ruPlural(list.length,['вещь','вещи','вещей'])}${filters.query?' по запросу «'+filters.query+'»':''}`;el('products').innerHTML=show.length?show.map(productCard).join(''):`<div class="no-results"><h3>Ничего не найдено</h3><p>Попробуйте другие размеры, цвет или ценовой диапазон.</p><button class="outline-btn" id="clearEmpty">Очистить фильтры</button></div>`;el('showMore').hidden=show.length===list.length;revealNew()}
  function ruPlural(n,forms){return forms[n%10===1&&n%100!==11?0:n%10>=2&&n%10<=4&&(n%100<12||n%100>14)?1:2]}
  function renderCartCount(){const qty=cart.reduce((a,c)=>a+c.qty,0);el('cartCount').textContent=qty;save('an_demo_cart_v1',cart)}
  function resetFilters(){filters.categories.clear();filters.sizes.clear();filters.colors.clear();filters.max=maxPrice();filters.query='';filters.sort='featured';displayedCount=9;el('searchInput').value='';renderFilters();renderCatalog();makeSelect('sortSelect',SORT_OPTIONS,filters.sort,value=>{filters.sort=value;renderCatalog()})}
  const SORT_OPTIONS=[['featured','По умолчанию'],['new','Сначала новинки'],['price-asc','Сначала дешевле'],['price-desc','Сначала дороже']];
