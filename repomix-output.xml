.shape {
  display: block;
  position: relative;
  overflow: hidden;
  background: #e6e3dc;
  border-radius: 2px;
  isolation: isolate;
  min-height: 1em;
}
.shape::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(
    100deg,
    transparent 20%,
    #ffffff55 50%,
    transparent 80%
  );
  animation: shimmer 1.8s ease-in-out infinite;
}
.text {
  height: 12px;
  margin: 12px 0;
  width: 80%;
}
.title {
  height: 48px;
  width: 65%;
  margin: 0 0 24px;
}
.photo {
  aspect-ratio: 0.74;
  width: 100%;
}
.block {
  min-height: 130px;
  width: 100%;
}
.fill {
  position: absolute;
  inset: 0;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 36px 15px;
}
.loader {
  position: fixed;
  inset: 0 0 auto;
  height: 3px;
  z-index: 200;
  overflow: hidden;
  background: #dcdad466;
  pointer-events: none;
}
.loader::after {
  content: "";
  position: absolute;
  width: 35%;
  height: 100%;
  background: #857764;
  animation: progress 1s ease-in-out infinite;
}
.media {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #e5e3df;
}
.media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.4s;
}
.hidden {
  opacity: 0;
}
.failure {
  display: grid;
  place-items: center;
  position: absolute;
  inset: 0;
  color: #777670;
  padding: 20px;
  font-size: 11px;
  text-align: center;
}
.spinner {
  width: 14px;
  height: 14px;
  display: inline-block;
  vertical-align: middle;
  border: 1px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-right: 9px;
}
@keyframes shimmer {
  to {
    transform: translateX(100%);
  }
}
@keyframes progress {
  from {
    left: -35%;
  }
  to {
    left: 100%;
  }
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@media (max-width: 800px) {
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (prefers-reduced-motion: reduce) {
  .shape::after,
  .loader::after,
  .spinner {
    animation: none;
  }
  .loader::after {
    left: 0;
    width: 100%;
  }
}
