  function addToCart(){if(!selectedSize){el('detailError').textContent='Выберите размер, чтобы продолжить';return}const existing=cart.find(c=>c.id===selectedProduct.id&&c.color===selectedColor&&c.size===selectedSize);if(existing)existing.qty=Math.min(99,existing.qty+selectedQty);else cart.push({id:selectedProduct.id,color:selectedColor,size:selectedSize,qty:selectedQty});renderCartCount();toast('Вещь добавлена в корзину');showCart()}
  function cartTotals(){const subtotal=cart.reduce((acc,c)=>acc+(byId(c.id)?.price||0)*c.qty,0);const discount=promo==='LIST10'?Math.round(subtotal*.1):0;return{subtotal,discount,total:subtotal-discount}}
  function showCart(){const t=cartTotals();openPanel('Корзина',cart.length?`<div id="cartItems">${cart.map((c,i)=>{const p=byId(c.id);return `<article class="cart-item"><img src="${escapeHTML(p.image)}" alt="${escapeHTML(p.name)}" loading="lazy"><div><div class="cart-item-name">${escapeHTML(p.name)}</div><div class="subdued">${escapeHTML(c.color)} · ${escapeHTML(c.size)}</div><div class="cart-line-bottom"><div class="stepper"><button data-cart-minus="${i}" aria-label="Уменьшить количество">−</button><output>${c.qty}</output><button data-cart-plus="${i}" aria-label="Увеличить количество">+</button></div><span class="price-strong">${fmt(p.price*c.qty)}</span></div><button class="remove-btn" data-cart-remove="${i}">Удалить</button></div></article>`}).join('')}</div><div><label class="form-label" for="promoCode">Промокод</label><div class="promo-row"><input class="input" id="promoCode" placeholder="Например, LIST10" value="${escapeHTML(promo==='LIST10'?'LIST10':'')}" maxlength="20"><button class="outline-btn" id="applyPromo">Применить</button></div><p class="promo-message ${promo==='LIST10'?'ok':''}" id="promoMessage">${promo==='LIST10'?'Скидка 10% применена':'Попробуйте LIST10 — скидка 10% в демо'}</p></div><div class="cart-summary"><div class="cart-row"><span>Товары</span><span>${fmt(t.subtotal)}</span></div>${t.discount?`<div class="cart-row"><span>Скидка по промокоду</span><span>−${fmt(t.discount)}</span></div>`:''}<div class="cart-row"><span>Доставка</span><span>Рассчитаем при оформлении</span></div><div class="cart-row total"><span>Промежуточный итог</span><span>${fmt(t.total)}</span></div><button id="goCheckout" class="primary-btn full">Перейти к оформлению</button><p class="checkout-note">Данные корзины хранятся только в вашем браузере. Реальная оплата в демо недоступна.</p></div>`:`<div class="empty-cart"><h3>Пока пусто</h3><p>Вещи, которые вы выберете, появятся здесь.</p><button id="goCatalog" class="primary-btn">К коллекции</button></div>`,'cart')}
  const CITIES={'Москва':{price:390,points:['Москва, ул. Тверская, 18','Москва, ул. Большая Полянка, 28','Москва, пр-т Мира, 102']},'Санкт-Петербург':{price:450,points:['Санкт-Петербург, Невский пр-т, 70','Санкт-Петербург, Лиговский пр-т, 50']},'Екатеринбург':{price:590,points:['Екатеринбург, ул. Малышева, 42','Екатеринбург, пр-т Ленина, 24']}};
  let city='',pickup='';
  function selectMarkup(id){return `<div class="select" id="${id}"></div>`}
  function showCheckout(){if(!cart.length){showCart();return}city='';pickup='';const t=cartTotals();openPanel('Оформление заказа',`<h3 class="checkout-title">Получение и оплата</h3><form id="checkoutForm" novalidate><div class="form-grid"><div class="field"><label class="form-label" for="customerName">Имя и фамилия *</label><input id="customerName" name="name" class="input" autocomplete="name" required minlength="2"><div class="error-msg" data-error="name"></div></div><div class="field"><label class="form-label" for="customerPhone">Телефон *</label><input id="customerPhone" name="phone" class="input" type="tel" placeholder="+7 999 123-45-67" autocomplete="tel" required><div class="error-msg" data-error="phone"></div></div></div><div class="field"><label class="form-label" for="customerEmail">Электронная почта *</label><input id="customerEmail" name="email" class="input" type="email" autocomplete="email" placeholder="name@example.ru" required><div class="error-msg" data-error="email"></div></div><div class="field"><label class="form-label">Город доставки *</label>${selectMarkup('citySelect')}<div class="error-msg" data-error="city"></div></div><div class="field"><label class="form-label">Пункт выдачи СДЭК *</label>${selectMarkup('pickupSelect')}<div class="error-msg" data-error="pickup"></div></div><p class="field-hint">Пункты выдачи и стоимость доставки — пример для проверки макета, не актуальные данные СДЭК.</p><div class="field"><label class="form-label">Способ оплаты</label><div class="payment-options">Банковская карта онлайн · демонстрация</div></div><div class="checkout-summary" id="checkoutSummary"></div><label class="legal-check"><input type="checkbox" id="privacyAgree" required><span>Понимаю, что это демонстрационный сайт, данные никуда не отправляются и реальной оплаты не происходит.</span></label><div class="error-msg" data-error="agree"></div><button type="submit" class="primary-btn full" id="submitOrder">Проверить и оформить демо-заказ</button><p class="checkout-note">Реальная обработка платежей, вебхуки и создание отправлений в СДЭК требуют серверной интеграции.</p></form>`,'checkout');makeSelect('citySelect',[['','Выберите город'],...Object.keys(CITIES).map(c=>[c,c])],'',v=>{city=v;pickup='';makeSelect('pickupSelect',pickupOpts(),pickup,v=>{pickup=v;el('pickupSelect').removeAttribute('data-invalid')});renderCheckoutSummary()});makeSelect('pickupSelect',pickupOpts(),pickup,v=>pickup=v);renderCheckoutSummary()}
  function pickupOpts(){return [['','Выберите пункт выдачи'],...(CITIES[city]?.points||[]).map(p=>[p,p])]}
  function renderCheckoutSummary(){const t=cartTotals(),shipping=CITIES[city]?.price||0;const box=el('checkoutSummary');if(!box)return;box.innerHTML=`<div class="cart-row"><span>Товары (${cart.reduce((n,c)=>n+c.qty,0)})</span><span>${fmt(t.subtotal)}</span></div>${t.discount?`<div class="cart-row"><span>Промокод LIST10</span><span>−${fmt(t.discount)}</span></div>`:''}<div class="cart-row"><span>Доставка, демо-тариф</span><span>${city?fmt(shipping):'Выберите город'}</span></div><div class="cart-row total"><span>Итого</span><span>${fmt(t.total+shipping)}</span></div>`}
  function validateCheckout(form){let valid=true;const errs={};const name=form.elements.name.value.trim();const phone=form.elements.phone.value.replace(/\D/g,'');const email=form.elements.email.value.trim();if(name.length<2)errs.name='Укажите имя (не менее двух символов)';if(phone.length<10||phone.length>15)errs.phone='Укажите корректный номер телефона';if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email))errs.email='Проверьте адрес электронной почты';if(!city)errs.city='Выберите город';if(!pickup)errs.pickup='Выберите пункт выдачи';if(!el('privacyAgree').checked)errs.agree='Подтвердите условия демонстрации';for(const key of ['name','phone','email','city','pickup','agree']){const node=el('panelBody').querySelector(`[data-error="${key}"]`);if(node)node.textContent=errs[key]||'';const f=form.elements[key];if(f&&f.tagName==='INPUT'&&key!=='agree')f.setAttribute('aria-invalid',String(!!errs[key]));if(errs[key])valid=false}if(!valid)el('panelBody').querySelector('.error-msg:not(:empty)')?.scrollIntoView({behavior:'smooth',block:'center'});return valid}
  function confirmOrder(){const orderNo='DEMO-'+Date.now().toString().slice(-7);const t=cartTotals(),total=t.total+(CITIES[city]?.price||0);orders.unshift({number:orderNo,items:cart.map(c=>({id:c.id,name:byId(c.id)?.name,qty:c.qty,size:c.size,color:c.color})),total,city,pickup,time:new Date().toLocaleString('ru-RU')});save('list_demo_orders_v1',orders);cart=[];promo='';renderCartCount();openPanel('Демо-заказ оформлен',`<div class="confirmation"><div class="small-cap">${orderNo}</div><h3>Вы прошли оформление заказа.</h3><p>Итого: <strong>${fmt(total)}</strong></p><p>Выбранный пункт: ${escapeHTML(pickup)}</p><p><strong>Это только демонстрация.</strong> Заказ не отправлен продавцу, оплата не проведена, отправление СДЭК не создано. Для реальной работы нужны backend и интеграции.</p><button class="primary-btn" id="confirmationCatalog">Вернуться в каталог</button></div>`,'success')}
  function toggleMenu(force){const nav=el('mobileNav'),open=typeof force==='boolean'?force:nav.hidden;nav.hidden=!open;el('menuBtn').setAttribute('aria-expanded',String(open))}
  function closeFilters(){el('filters').classList.remove('mobile-visible');el('mobileFilters').setAttribute('aria-expanded','false');document.body.classList.remove('lock')}
  function toggleSearch(force){const bar=el('searchbar'),open=typeof force==='boolean'?force:bar.hidden;bar.hidden=!open;document.querySelectorAll('[data-open-search]').forEach(x=>x.setAttribute('aria-expanded',String(open)));if(open){toggleMenu(false);el('searchInput').focus()}else{filters.query='';el('searchInput').value='';renderCatalog()}}
  function downloadTemplate(){const csv='name;category;price;image;colors;sizes\nКуртка Новая;Верхняя одежда;14900;https://images.unsplash.com/photo-1515886657613-9f3515b0c78f;Чёрный,Графит;S,M,L\n';const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='products_template.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1500)}
  function parseCSV(text){const delimiter=(text.split(/\r?\n/)[0].match(/;/g)||[]).length>=(text.split(/\r?\n/)[0].match(/,/g)||[]).length?';':',';let rows=[],row=[],value='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'){if(quoted&&text[i+1]==='"'){value+='"';i++}else quoted=!quoted}else if(c===delimiter&&!quoted){row.push(value);value=''}else if((c==='\n'||c==='\r'&&text[i+1]!=='\n')&&!quoted){row.push(value);if(row.some(v=>v.trim()))rows.push(row);row=[];value=''}else if(c!=='\r'||quoted)value+=c}row.push(value);if(row.some(v=>v.trim()))rows.push(row);return rows}
  function adminList(){return `<p class="admin-meta">Данные для демонстрации. Изменения сохраняются локально в браузере и не появляются у других посетителей. Excel-файл можно экспортировать в CSV UTF-8 и импортировать ниже.</p><div class="admin-top"><span class="subdued">${products.length} товаров</span><button class="outline-btn" id="addProductAdmin">Добавить товар</button></div><div class="admin-top"><button class="link-btn" id="downloadCSV">Скачать шаблон CSV</button><label class="link-btn" style="cursor:pointer">Импорт CSV <input type="file" id="importCSV" accept=".csv,text/csv" hidden></label></div><div id="adminEdit"></div><div class="admin-list">${products.map(p=>`<div class="admin-line"><img src="${escapeHTML(p.image)}" alt=""><div><strong>${escapeHTML(p.name)}</strong><small>${escapeHTML(p.category)} · ${fmt(p.price)}</small></div><div><button data-edit="${escapeHTML(p.id)}">Изменить</button><button data-delete="${escapeHTML(p.id)}">Удалить</button></div></div>`).join('')}</div><div style="margin-top:25px"><button class="link-btn" id="restoreCatalog">Восстановить исходные демотовары</button></div>`}
  function adminOrders(){return `<p class="admin-meta">В демо показывается история проверочных заказов без хранения контактных данных покупателей.</p>${orders.length?`<ol class="admin-orders">${orders.map(o=>`<li><strong>${escapeHTML(o.number)}</strong> · ${escapeHTML(o.time)} · ${fmt(o.total)}<br><span class="subdued">${escapeHTML(o.city)} · ${escapeHTML(o.pickup)}</span><br>${o.items.map(i=>escapeHTML(i.name)+' ('+escapeHTML(i.color)+', '+escapeHTML(i.size)+') × '+i.qty).join('; ')}</li>`).join('')}</ol>`:`<p class="subdued">Пока нет демо-заказов. Сделайте тестовую покупку через корзину.</p>`}`}
  function showAdmin(tab='goods'){openPanel('Демо-админка',`<div class="admin-tabs"><button id="adminGoods" class="${tab==='goods'?'active':''}" aria-pressed="${tab==='goods'}">Товары</button><button id="adminOrders" class="${tab==='orders'?'active':''}" aria-pressed="${tab==='orders'}">Заказы (${orders.length})</button></div>${tab==='goods'?adminList():adminOrders()}`,'admin')}
  function openAdminEditor(id){const p=id?byId(id):null;el('adminEdit').innerHTML=`<form id="adminForm" class="admin-edit" novalidate><h3>${p?'Изменить товар':'Новый товар'}</h3><div class="field"><label class="form-label" for="aName">Название</label><input class="input" id="aName" value="${escapeHTML(p?.name||'')}" required></div><div class="form-grid"><div class="field"><label class="form-label" for="aCategory">Категория</label><input class="input" id="aCategory" value="${escapeHTML(p?.category||'Верхняя одежда')}" required></div><div class="field"><label class="form-label" for="aPrice">Цена, ₽</label><input class="input" id="aPrice" type="number" min="1" step="1" value="${p?.price||''}" required></div></div><div class="field"><label class="form-label" for="aImage">URL изображения (HTTPS)</label><input class="input" id="aImage" type="url" value="${escapeHTML(p?.image||'')}" placeholder="https://..." required></div><div class="form-grid"><div class="field"><label class="form-label" for="aColors">Цвета через запятую</label><input class="input" id="aColors" value="${escapeHTML(p?.colors.join(', ')||'Чёрный, Графит')}" required></div><div class="field"><label class="form-label" for="aSizes">Размеры через запятую</label><input class="input" id="aSizes" value="${escapeHTML(p?.sizes.join(', ')||'S, M, L')}" required></div></div><div class="field"><label class="form-label" for="aDesc">Краткое описание</label><textarea class="input" id="aDesc" rows="2">${escapeHTML(p?.description||'')}</textarea></div><div class="error-msg" id="adminError" role="status"></div><button class="primary-btn" type="submit">Сохранить товар</button> <button type="button" class="outline-btn" id="cancelEdit">Отмена</button></form>`;el('adminForm').dataset.id=id||'';el('aName').focus()}
  function saveAdminProduct(){const name=el('aName').value.trim(),category=el('aCategory').value.trim(),price=Number(el('aPrice').value),image=el('aImage').value.trim(),colors=el('aColors').value.split(',').map(s=>s.trim()).filter(Boolean),sizes=el('aSizes').value.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean),description=el('aDesc').value.trim();if(!name||!category||!Number.isFinite(price)||price<=0||!/^https:\/\//i.test(image)||!colors.length||!sizes.length||sizes.some(s=>!SIZE_LIST.includes(s))){el('adminError').textContent='Проверьте название, категорию, цену, HTTPS-изображение, цвета и размеры (XS–XXL).';return}const id=el('adminForm').dataset.id;const newP={id:id||'p'+Date.now(),name,category,price,image,colors,sizes,badge:'',description,rank:id?byId(id).rank:products.length};if(id){products=products.map(p=>p.id===id?newP:p)}else products.push(newP);save('list_demo_products_v1',products);filters.max=maxPrice();renderFilters();renderCatalog();showAdmin();toast('Товар сохранён локально')}
  // Делегирование событий для динамических карточек, модалок и админки.
  document.addEventListener('click',e=>{
    const target=e.target.closest('button,a');if(!target)return;
    const productBtn=target.closest('[data-product]');if(productBtn){showProduct(productBtn.dataset.product);return}
    if(target.dataset.detailColor){selectedColor=target.dataset.detailColor;el('chosenColor').textContent='Цвет: '+selectedColor;el('productColors').querySelectorAll('[data-detail-color]').forEach(b=>{b.classList.toggle('active',b===target);b.setAttribute('aria-pressed',String(b===target))});return}
    if(target.dataset.detailSize){selectedSize=target.dataset.detailSize;el('productSizes').querySelectorAll('[data-detail-size]').forEach(b=>{b.classList.toggle('active',b===target);b.setAttribute('aria-pressed',String(b===target))});el('detailError').textContent='';return}
    if(target.id==='detailMinus'||target.id==='detailPlus'){selectedQty=Math.max(1,Math.min(20,selectedQty+(target.id==='detailPlus'?1:-1)));updateDetailQty();return}
    if(target.id==='addToCart'){addToCart();return}
    if(target.dataset.cartRemove!==undefined){cart.splice(Number(target.dataset.cartRemove),1);renderCartCount();showCart();return}
    if(target.dataset.cartPlus!==undefined||target.dataset.cartMinus!==undefined){const idx=Number(target.dataset.cartPlus??target.dataset.cartMinus);if(target.dataset.cartPlus!==undefined)cart[idx].qty=Math.min(99,cart[idx].qty+1);else cart[idx].qty--;if(cart[idx].qty<=0)cart.splice(idx,1);renderCartCount();showCart();return}
    if(target.id==='cartBtn'||target.id==='footerCart'){showCart();return}
    if(target.id==='applyPromo'){const v=el('promoCode').value.trim().toUpperCase();if(v==='LIST10'){promo=v;showCart();toast('Промокод применён')}else{promo='';el('promoMessage').textContent='Промокод не найден. Для демо используйте LIST10';el('promoMessage').className='promo-message err'}return}
    if(target.id==='goCheckout'){showCheckout();return}
    if(target.id==='goCatalog'||target.id==='confirmationCatalog'){closePanel();el('catalog').scrollIntoView({behavior:'smooth'});return}
    if(target.dataset.openSearch!==undefined){toggleSearch();return}
    if(target.id==='closeSearch'){toggleSearch(false);return}
    if(target.id==='clearSearch'){el('searchInput').value='';filters.query='';renderCatalog();el('searchInput').focus();return}
    if(target.id==='menuBtn'){toggleMenu();return}
    if(target.closest('#mobileNav')&&target.tagName==='A'){toggleMenu(false)}
    if(target.id==='newArrivalsLink'||target.id==='newArrivalsMobile'){filters.sort='new';makeSelect('sortSelect',SORT_OPTIONS,'new',v=>{filters.sort=v;renderCatalog()});renderCatalog();return}
    if(target.id==='mobileFilters'){el('filters').classList.add('mobile-visible');target.setAttribute('aria-expanded','true');document.body.classList.add('lock');return}
    if(target.id==='closeFilters'){closeFilters();return}
    if(target.id==='resetFilters'||target.id==='clearEmpty'){resetFilters();return}
    if(target.dataset.sizeFilter){filters.sizes.has(target.dataset.sizeFilter)?filters.sizes.delete(target.dataset.sizeFilter):filters.sizes.add(target.dataset.sizeFilter);displayedCount=8;renderFilters();renderCatalog();return}
    if(target.dataset.colorFilter){filters.colors.has(target.dataset.colorFilter)?filters.colors.delete(target.dataset.colorFilter):filters.colors.add(target.dataset.colorFilter);displayedCount=8;renderFilters();renderCatalog();return}
    if(target.id==='showMore'){displayedCount+=8;renderCatalog();return}
    if(target.id==='openAdmin'){showAdmin();return}
    if(target.id==='adminGoods'){showAdmin('goods');return}
    if(target.id==='adminOrders'){showAdmin('orders');return}
    if(target.id==='addProductAdmin'){openAdminEditor();return}
    if(target.dataset.edit){openAdminEditor(target.dataset.edit);return}
    if(target.dataset.delete){const p=byId(target.dataset.delete);if(!p)return;if(confirm('Удалить «'+p.name+'» из демонстрационного каталога?')){products=products.filter(x=>x.id!==p.id);cart=cart.filter(c=>c.id!==p.id);save('list_demo_products_v1',products);renderCartCount();renderFilters();renderCatalog();showAdmin();toast('Товар удалён из локального каталога')}return}
    if(target.id==='cancelEdit'){el('adminEdit').innerHTML='';return}
    if(target.id==='downloadCSV'){downloadTemplate();return}
    if(target.id==='restoreCatalog'){products=defaults.map(p=>({...p}));save('list_demo_products_v1',products);cart=[];renderCartCount();resetFilters();showAdmin();toast('Демотовары восстановлены');return}
  });
  document.addEventListener('change',e=>{if(e.target.matches('[data-cat]')){const c=e.target.dataset.cat;if(e.target.checked)filters.categories.add(c);else filters.categories.delete(c);displayedCount=8;renderCatalog()}if(e.target.id==='importCSV'){const file=e.target.files?.[0];if(!file)return;file.text().then(txt=>{const rows=parseCSV(txt.replace(/^\uFEFF/,''));const head=rows.shift()?.map(x=>x.trim().toLowerCase());const keys=['name','category','price','image','colors','sizes'];if(!head||keys.some(k=>!head.includes(k))){toast('CSV должен содержать столбцы '+keys.join(', '));return}const list=[];for(const line of rows){const obj=Object.fromEntries(keys.map(k=>[k,(line[head.indexOf(k)]||'').trim()]));const price=Number(obj.price.replace(',','.'));const sizes=obj.sizes.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);if(!obj.name||!obj.category||!price||!/^https:\/\//.test(obj.image)||!sizes.length||sizes.some(s=>!SIZE_LIST.includes(s)))continue;list.push({id:'csv'+Date.now()+list.length,name:obj.name,category:obj.category,price,image:obj.image,colors:obj.colors.split(',').map(c=>c.trim()).filter(Boolean),sizes,badge:'',description:'Демонстрационная карточка, импортированная из CSV.',rank:products.length+list.length})}if(!list.length){toast('Не удалось импортировать строки. Проверьте шаблон');return}products.push(...list);save('list_demo_products_v1',products);resetFilters();showAdmin();toast(`Добавлено ${list.length} товаров из CSV`)})}});
  document.addEventListener('submit',e=>{if(e.target.id==='adminForm'){e.preventDefault();saveAdminProduct()}if(e.target.id==='checkoutForm'){e.preventDefault();const form=e.target;if(!validateCheckout(form))return;const button=el('submitOrder');if(button.disabled)return;button.disabled=true;button.textContent='Проверка данных...';setTimeout(()=>{if(activePanel==='checkout')confirmOrder()},650)}});
  el('priceRange').addEventListener('input',e=>{filters.max=Number(e.target.value);el('priceMaxLabel').textContent='до '+fmt(filters.max);displayedCount=8;renderCatalog()});
  el('searchInput').addEventListener('input',e=>{filters.query=e.target.value.trim();displayedCount=8;renderCatalog()});
  el('menuBtn').addEventListener('keydown',e=>{if(e.key==='ArrowDown'){toggleMenu(true);el('mobileNav').querySelector('a')?.focus()}});
  // Каталог доступен без сборки и без backend; интеграции внешних сервисов не имитируют реальный платёж.
  renderFilters();renderCatalog();renderCartCount();makeSelect('sortSelect',SORT_OPTIONS,'featured',v=>{filters.sort=v;renderCatalog()});revealNew();
  

</script>
</body></html>
