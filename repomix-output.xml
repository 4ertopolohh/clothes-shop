  gap: 12px;
  margin-bottom: 20px;
}
.admin-list {
  border-top: 1px solid var(--line);
}
.admin-line {
  display: grid;
  grid-template-columns: 45px 1fr auto;
  gap: 14px;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
}
.admin-line img {
