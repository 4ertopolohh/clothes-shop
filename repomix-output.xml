              {pointError && (
                <ErrorState
                  error={pointError}
                  retry={() => setRevision((x) => x + 1)}
                />
              )}
            </div>
          ) : (
            <div className={cx("field")}>
              <label className={cx("form-label")} htmlFor="address">
                Улица, дом, квартира
              </label>
              <input
                id="address"
                className={cx("input")}
                autoComplete="street-address"
                required
                minLength={8}
                maxLength={400}
                value={address}
                onChange={(e) => setAddress(e.target.value)}
