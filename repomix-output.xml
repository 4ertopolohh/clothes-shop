/* LIST / Atelier — independent editorial design language */
:root{--paper:#f6f1e7;--white:#fffdf8;--ink:#263a31;--secondary:#7f786a;--line:#d5cabc;--cloud:#e9dfce;--black:#24392e;--font:'IBM Plex Sans',sans-serif;--display:'Literata',serif;--ease:cubic-bezier(.16,1,.3,1);--terracotta:#a95f47;--stone:#cfc1a7}
html{scroll-behavior:smooth}body{font-family:var(--font);background:var(--paper);color:var(--ink);font-size:14px;line-height:1.65}body.lock{overflow:hidden}
::selection{background:#334b3d;color:white}a,button{transition:color .2s,background-color .25s,border-color .25s,transform .25s}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--terracotta);outline-offset:3px}input[type=checkbox]{accent-color:var(--ink)}
.shell{max-width:1800px;margin-inline:auto}.topline{height:35px;display:flex;justify-content:space-between;padding:0 5.5%;align-items:center;background:var(--ink);color:#eee5d6;letter-spacing:.04em;font-size:10px}.topline i{font-style:normal;opacity:.7}.masthead{background:var(--paper);border-bottom:0}.head{height:105px;display:grid;grid-template-columns:1fr auto 1fr;gap:20px;padding:0 5.5%;border-bottom:1px solid var(--line)}.brand{font-family:var(--display);font-size:41px;letter-spacing:-.09em;font-weight:600;text-transform:lowercase;line-height:.85;color:var(--ink)}.brand small{font:400 9px/1.4 var(--font);letter-spacing:.3em;text-transform:uppercase;margin-top:9px;color:#6b746a}.desktop-nav{gap:29px}.desktop-nav a,.header-action{font-size:12px;letter-spacing:.015em}.desktop-nav a:hover,.header-action:hover{color:var(--terracotta);opacity:1}.header-actions{gap:16px}.header-action{border:none;background:transparent;padding:11px 4px}.bag-count{border-color:var(--ink);background:#eae3d6;border-radius:0;min-width:24px;height:23px;margin-left:9px;font-size:11px}.demo-ribbon{background:#e9e0d1;color:#6c675b;border-bottom:1px solid var(--line);padding:9px 5.5%;font-size:10px;text-align:center;letter-spacing:.01em}.searchbar{display:flex;gap:13px;align-items:center;padding:19px 5.5%;background:#ece4d8;border-bottom:1px solid var(--line)}.searchbar[hidden],.mobile-nav[hidden]{display:none}.searchbar input{flex:1;min-width:0;background:var(--white)}.searchbar button{background:transparent;border:0;text-decoration:underline;text-underline-offset:3px}.small-cap{font:500 11px var(--font);letter-spacing:.07em;text-transform:uppercase;color:var(--terracotta)}
/* editorial cover: large typographic opening followed by deliberately offset image triptych */
.hero{background:var(--paper);color:var(--ink);height:auto;max-height:none;min-height:0;display:block;padding:60px 5.5% 65px}.hero-top{display:grid;grid-template-columns:minmax(0,1.9fr) minmax(260px,.55fr);gap:35px;align-items:end}.hero-eyebrow{display:flex;align-items:center;gap:20px;margin-bottom:24px;font:500 11px var(--font);color:var(--terracotta)}.hero-eyebrow:before{content:'';display:block;width:38px;height:1px;background:var(--terracotta)}.hero h1{font-family:var(--display);font-weight:500;font-size:clamp(62px,7.8vw,142px);line-height:1.02;letter-spacing:-.09em;margin:0;max-width:none}.hero h1 em{font-weight:400;color:var(--terracotta)}.hero-side{border-left:1px solid var(--line);padding:0 0 11px 32px}.hero-side p{font:400 14px/1.75 var(--font);max-width:275px;color:#60675d;margin:0 0 24px}.hero-side a,.editorial-copy a{display:inline-flex;align-items:center;gap:15px;border-bottom:1px solid currentColor;padding:0 0 8px;font-weight:500;font-size:12px}.hero-side a:hover{color:var(--terracotta);gap:23px}.hero-gallery{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,.67fr) minmax(0,.37fr);align-items:end;column-gap:18px;margin-top:48px}.hero-frame{position:relative;background:#d6cbbb;overflow:hidden;min-width:0}.hero-frame img{width:100%;height:100%;object-fit:cover;object-position:center 34%;filter:sepia(.10) saturate(.78) contrast(.95);transition:transform 1.2s var(--ease)}.hero-frame:hover img{transform:scale(1.035)}.hero-main{aspect-ratio:1.27}.hero-offset{aspect-ratio:.78;margin-top:70px}.hero-sideframe{aspect-ratio:.65;align-self:start;margin-top:50px}.hero-note{margin-top:12px;display:flex;justify-content:space-between;gap:20px;color:#6b7164;font-size:11px}.hero-note strong{font-weight:500;color:var(--ink)}.cover-number{font-family:var(--display);font-style:italic;color:var(--terracotta);font-size:36px;align-self:end;margin-bottom:12px}.hero-last{display:flex;align-items:end;justify-content:space-between;gap:14px;flex-direction:column;height: