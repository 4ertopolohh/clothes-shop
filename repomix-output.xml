  function resetFilters(){filters.categories.clear();filters.sizes.clear();filters.colors.clear();filters.max=maxPrice();filters.query='';filters.sort='featured';displayedCount=8;el('searchInput').value='';renderFilters();renderCatalog();makeSelect('sortSelect',SORT_OPTIONS,filters.sort,value=>{filters.sort=value;renderCatalog()})}
  const SORT_OPTIONS=[['featured','По умолчанию'],['new','Сначала новинки'],['price-asc','Сначала дешевле'],['price-desc','Сначала дороже']];
