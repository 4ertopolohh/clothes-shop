  const selectState=new Map();
  function makeSelect(id,options,value,onChange){const root=el(id);if(!root)return;const state={options,value,onChange,opened:false,focused:Math.max(0,options.findIndex(o=>o[0]===value))};selectState.set(id,state);root.classList.remove('open');root.innerHTML=`<button type="button" class="select-trigger" aria-haspopup="listbox" aria-controls="${id}Options" aria-expanded="false" id="${id}Trigger">${escapeHTML(options.find(o=>o[0]===value)?.[1]||'Выберите')}</button><div id="${id}Options" class="select-options" role="listbox" aria-label="${id==='sortSelect'?'Сортировка':id==='citySelect'?'Город':'Пункт выдачи'}" hidden>${options.map((o,i)=>`<button type="button" class="select-option ${i===state.focused?'selected':''}" role="option" data-option="${i}" aria-selected="${o[0]===value}">${escapeHTML(o[1])}</button>`).join('')}</div>`;
    const trigger=root.querySelector('.select-trigger');trigger.addEventListener('click',()=>toggleSelect(id));trigger.addEventListener('keydown',e=>{if(['ArrowDown','ArrowUp','Enter',' '].includes(e.key)){e.preventDefault();if(!state.opened)toggleSelect(id);else if(e.key==='ArrowDown'||e.key==='ArrowUp'){state.focused=(state.focused+(e.key==='ArrowDown'?1:-1)+options.length)%options.length;focusOption(id)}else chooseOption(id,state.focused)}else if(e.key==='Escape'&&state.opened){e.preventDefault();toggleSelect(id,false)}});root.addEventListener('click',e=>{const b=e.target.closest('[data-option]');if(b)chooseOption(id,Number(b.dataset.option))});root.addEventListener('keydown',e=>{if(!state.opened||e.target===trigger)return;if(['ArrowDown','ArrowUp','Home','End'].includes(e.key)){e.preventDefault();state.focused=e.key==='Home'?0:e.key==='End'?options.length-1:(state.focused+(e.key==='ArrowDown'?1:-1)+options.length)%options.length;focusOption(id)}if(e.key==='Escape'){e.preventDefault();toggleSelect(id,false);trigger.focus()}if(e.key==='Enter'||e.key===' '){e.preventDefault();chooseOption(id,state.focused)}})
  }
  function focusOption(id){const root=el(id),state=selectState.get(id);root.querySelectorAll('[data-option]').forEach((o,i)=>{o.classList.toggle('highlight',i===state.focused);o.tabIndex=i===state.focused?0:-1});root.querySelector(`[data-option="${state.focused}"]`)?.focus()}
  function toggleSelect(id,force){const state=selectState.get(id);if(!state)return;for(const [other,s] of selectState){if(other!==id&&s.opened)toggleSelect(other,false)}const show=typeof force==='boolean'?force:!state.opened;state.opened=show;const root=el(id);if(!root)return;root.classList.toggle('open',show);root.querySelector('.select-options').hidden=!show;root.querySelector('.select-trigger').setAttribute('aria-expanded',String(show));if(show)focusOption(id)}
  function chooseOption(id,i){const s=selectState.get(id);if(!s)return;s.value=s.options[i][0];s.focused=i;s.onChange(s.value);if(el(id)){const label=s.options[i][1];el(id).querySelector('.select-trigger').textContent=label;el(id).querySelectorAll('[data-option]').forEach((b,k)=>{b.classList.toggle('selected',i===k);b.setAttribute('aria-selected',String(i===k))});toggleSelect(id,false);el(id).querySelector('.select-trigger').focus()}}
