  function showAdmin(tab='goods'){openPanel('Демо-админка',`<div class="admin-tabs"><button id="adminGoods" class="${tab==='goods'?'active':''}" aria-pressed="${tab==='goods'}">Товары</button><button id="adminOrders" class="${tab==='orders'?'active':''}" aria-pressed="${tab==='orders'}">Заказы (${orders.length})</button></div>${tab==='goods'?adminList():adminOrders()}`,'admin')}
  function openAdminEditor(id){const p=id?byId(id):null;el('adminEdit').innerHTML=`<form id="adminForm" class="admin-edit" novalidate><h3>${p?'Изменить товар':'Новый товар'}</h3><div class="field"><label class="form-label" for="aName">Название</label><input class="input" id="aName" value="${escapeHTML(p?.name||'')}" required></div><div class="form-grid"><div class="field"><label class="form-label" for="aCategory">Категория</label><input class="input" id="aCategory" value="${escapeHTML(p?.category||'Верхняя одежда')}" required></div><div class="field"><label class="form-label" for="aPrice">Цена, ₽</label><input class="input" id="aPrice" type="number" min="1" step="1" value="${p?.price||''}" required></div></div><div class="field"><label class="form-label" for="aImage">URL изображения (HTTPS)</label><input class="input" id="aImage" type="url" value="${escapeHTML(p?.image||'')}" placeholder="https://..." required></div><div class="form-grid"><div class="field"><label class="form-label" for="aColors">Цвета через запятую</label><input class="input" id="aColors" value="${escapeHTML(p?.colors.join(', ')||'Чёрный, Графит')}" required></div><div class="field"><label class="form-label" for="aSizes">Размеры через запятую</label><input class="input" id="aSizes" value="${escapeHTML(p?.sizes.join(', ')||'S, M, L')}" required></div></div><div class="field"><label class="form-label" for="aDesc">Краткое описание</label><textarea class="input" id="aDesc" rows="2">${escapeHTML(p?.description||'')}</textarea></div><div class="error-msg" id="adminError" role="status"></div><button class="primary-btn" type="submit">Сохранить товар</button> <button type="button" class="outline-btn" id="cancelEdit">Отмена</button></form>`;el('adminForm').dataset.id=id||'';el('aName').focus()}
  function saveAdminProduct(){const name=el('aName').value.trim(),category=el('aCategory').value.trim(),price=Number(el('aPrice').value),image=el('aImage').value.trim(),colors=el('aColors').value.split(',').map(s=>s.trim()).filter(Boolean),sizes=el('aSizes').value.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean),description=el('aDesc').value.trim();if(!name||!category||!Number.isFinite(price)||price<=0||!/^https:\/\//i.test(image)||!colors.length||!sizes.length||sizes.some(s=>!SIZE_LIST.includes(s))){el('adminError').textContent='Проверьте название, категорию, цену, HTTPS-изображение, цвета и размеры (XS–XXL).';return}const id=el('adminForm').dataset.id;const newP={id:id||'p'+Date.now(),name,category,price,image,colors,sizes,badge:'',description,rank:id?byId(id).rank:products.length};if(id){products=products.map(p=>p.id===id?newP:p)}else products.push(newP);save('shum_demo_products_v1',products);filters.max=maxPrice();renderFilters();renderCatalog();showAdmin();toast('Товар сохранён локально')}
  // Делегирование событий для динамических карточек, модалок и админки.
  document.addEventListener('click',e=>{
    const target=e.target.closest('button,a');if(!target)return;
    const productBtn=target.closest('[data-product]');if(productBtn){showProduct(productBtn.dataset.product);return}
    if(target.dataset.detailColor){selectedColor=target.dataset.detailColor;el('chosenColor').textContent='Цвет: '+selectedColor;el('productColors').querySelectorAll('[data-detail-color]').forEach(b=>{b.classList.toggle('active',b===target);b.setAttribute('aria-pressed',String(b===target))});return}
    if(target.dataset.detailSize){selectedSize=target.dataset.detailSize;el('productSizes').querySelectorAll('[data-detail-size]').forEach(b=>{b.classList.toggle('active',b===target);b.setAttribute('aria-pressed',String(b===target))});el('detailError').textContent='';return}
    if(target.id==='detailMinus'||target.id==='detailPlus'){selectedQty=Math.max(1,Math.min(20,selectedQty+(target.id==='detailPlus'?1:-1)));updateDetailQty();return}
    if(target.id==='addToCart'){addToCart();return}
    if(target.dataset.cartRemove!==undefined){cart.splice(Number(target.dataset.cartRemove),1);renderCartCount();showCart();return}
    if(target.dataset.cartPlus!==undefined||target.dataset.cartMinus!==undefined){const idx=Number(target.dataset.cartPlus??target.dataset.cartMinus);if(target.dataset.cartPlus!==undefined)cart[idx].qty=Math.min(99,cart[idx].qty+1);else cart[idx].qty--;if(cart[idx].qty<=0)cart.splice(idx,1);renderCartCount();showCart();return}
    if(target.id==='cartBtn'||target.id==='footerCart'){showCart();return}
    if(target.id==='applyPromo'){const v=el('promoCode').value.trim().toUpperCase();if(v==='FORM10'){promo=v;showCart();toast('Промокод применён')}else{promo='';el('promoMessage').textContent='Промокод не найден. Для демо используйте FORM10';el('promoMessage').className='promo-message err'}return}
    if(target.id==='goCheckout'){showCheckout();return}
    if(target.id==='goCatalog'||target.id==='confirmationCatalog'){closePanel();el('catalog').scrollIntoView({behavior:'smooth'});return}
    if(target.dataset.openSearch!==undefined){toggleSearch();return}
    if(target.id==='closeSearch'){toggleSearch(false);return}
    if(target.id==='clearSearch'){el('searchInput').value='';filters.query='';renderCatalog();el('searchInput').focus();return}
    if(target.id==='menuBtn'){toggleMenu();return}
    if(target.closest('#mobileNav')&&target.tagName==='A'){toggleMenu(false)}
    if(target.id==='newArrivalsLink'||target.id==='newArrivalsMobile'){filters.sort='new';makeSelect('sortSelect',SORT_OPTIONS,'new',v=>{filters.sort=v;renderCatalog()});renderCatalog();return}
    if(target.id==='mobileFilters'){el('filters').classList.add('mobile-visible');target.setAttribute('aria-expanded','true');document.body.classList.add('lock');return}
    if(target.id==='closeFilters'){closeFilters();return}
    if(target.id==='resetFilters'||target.id==='clearEmpty'){resetFilters();return}
    if(target.dataset.sizeFilter){filters.sizes.has(target.dataset.sizeFilter)?filters.sizes.delete(target.dataset.sizeFilter):filters.sizes.add(target.dataset.sizeFilter);displayedCount=9;renderFilters();renderCatalog();return}
    if(target.dataset.colorFilter){filters.colors.has(target.dataset.colorFilter)?filters.colors.delete(target.dataset.colorFilter):filters.colors.add(target.dataset.colorFilter);displayedCount=9;renderFilters();renderCatalog();return}
    if(target.id==='showMore'){displayedCount+=9;renderCatalog();return}
    if(target.id==='openAdmin'){showAdmin();return}
    if(target.id==='adminGoods'){showAdmin('goods');return}
    if(target.id==='adminOrders'){showAdmin('orders');return}
    if(target.id==='addProductAdmin'){openAdminEditor();return}
    if(target.dataset.edit){openAdminEditor(target.dataset.edit);return}
    if(target.dataset.delete){const p=byId(target.dataset.delete);if(!p)return;if(confirm('Удалить «'+p.name+'» из демонстрационного каталога?')){products=products.filter(x=>x.id!==p.id);cart=cart.filter(c=>c.id!==p.id);save('shum_demo_products_v1',products);renderCartCount();renderFilters();renderCatalog();showAdmin();toast('Товар удалён из локального каталога')}return}
    if(target.id==='cancelEdit'){el('adminEdit').innerHTML='';return}
    if(target.id==='downloadCSV'){downloadTemplate();return}
    if(target.id==='restoreCatalog'){products=defaults.map(p=>({...p}));save('shum_demo_products_v1',products);cart=[];renderCartCount();resetFilters();showAdmin();toast('Демотовары восстановлены');return}
  });
  document.addEventListener('change',e=>{if(e.target.matches('[data-cat]')){const c=e.target.dataset.cat;if(e.target.checked)filters.categories.add(c);else filters.categories.delete(c);displayedCount=9;renderCatalog()}if(e.target.id==='importCSV'){const file=e.target.files?.[0];if(!file)return;file.text().then(txt=>{const rows=parseCSV(txt.replace(/^\uFEFF/,''));const head=rows.shift()?.map(x=>x.trim().toLowerCase());const keys=['name','category','price','image','colors','sizes'];if(!head||keys.some(k=>!head.includes(k))){toast('CSV должен содержать столбцы '+keys.join(', '));return}const list=[];for(const line of rows){const obj=Object.fromEntries(keys.map(k=>[k,(line[head.indexOf(k)]||'').trim()]));const price=Number(obj.price.replace(',','.'));const sizes=obj.sizes.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);if(!obj.name||!obj.category||!price||!/^https:\/\//.test(obj.image)||!sizes.length||sizes.some(s=>!SIZE_LIST.includes(s)))continue;list.push({id:'csv'+Date.now()+list.length,name:obj.name,category:obj.category,price,image:obj.image,colors:obj.colors.split(',').map(c=>c.trim()).filter(Boolean),sizes,badge:'',description:'Демонстрационная карточка, импортированная из CSV.',rank:products.length+list.length})}if(!list.length){toast('Не удалось импортировать строки. Проверьте шаблон');return}products.push(...list);save('shum_demo_products_v1',products);resetFilters();showAdmin();toast(`Добавлено ${list.length} товаров из CSV`)})}});
  document.addEventListener('submit',e=>{if(e.target.id==='adminForm'){e.preventDefault();saveAdminProduct()}if(e.target.id==='checkoutForm'){e.preventDefault();const form=e.target;if(!validateCheckout(form))return;const button=el('submitOrder');if(button.disabled)return;button.disabled=true;button.textContent='Проверка данных...';setTimeout(()=>{if(activePanel==='checkout')confirmOrder()},650)}});
  el('priceRange').addEventListener('input',e=>{filters.max=Number(e.target.value);el('priceMaxLabel').textContent='до '+fmt(filters.max);displayedCount=9;renderCatalog()});
  el('searchInput').addEventListener('input',e=>{filters.query=e.target.value.trim();displayedCount=9;renderCatalog()});
  el('menuBtn').addEventListener('keydown',e=>{if(e.key==='ArrowDown'){toggleMenu(true);el('mobileNav').querySelector('a')?.focus()}});
  // Каталог доступен без сборки и без backend; интеграции внешних сервисов не имитируют реальный платёж.
  renderFilters();renderCatalog();renderCartCount();makeSelect('sortSelect',SORT_OPTIONS,'featured',v=>{filters.sort=v;renderCatalog()});revealNew();
  
</script>
</body></html>
