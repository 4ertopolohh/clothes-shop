<body>
<div class="masthead" id="top">
  <div class="topline">Одежда для тех, кому тесно в рамках</div>
  <header class="head shell">
    <button class="header-action mobile-menu-btn" id="menuBtn" aria-controls="mobileNav" aria-expanded="false">Меню</button>
    <nav class="desktop-nav" aria-label="Главная навигация">
      <a href="#catalog">Коллекция</a><a href="#catalog" id="newArrivalsLink">Новинки</a>
      <a href="#manifesto">Наша идея</a><a href="#delivery">Доставка и оплата</a>
    </nav>
    <a class="brand" href="#top" aria-label="SHUM — главная">SHUM.<small>COLOR CLUB / WEAR YOUR MOOD</small></a>
    <div class="header-actions"><button class="header-action search-label" data-open-search aria-expanded="false">Поиск</button><button class="header-action" id="cartBtn" aria-label="Открыть корзину">Корзина <span class="bag-count" id="cartCount">0</span></button></div>
  </header>
  <nav class="mobile-nav" id="mobileNav" aria-label="Мобильная навигация" hidden>
    <a href="#catalog">Коллекция</a><a href="#catalog" id="newArrivalsMobile">Новинки</a>
    <a href="#manifesto">Наша идея</a><a href="#delivery">Доставка и оплата</a>
    <button class="header-action" data-open-search aria-expanded="false">Найти вещь</button>
  </nav>
  <div class="searchbar shell" id="searchbar" hidden><label class="small-cap" for="searchInput">Что ищем?</label><input class="input" id="searchInput" type="search" autocomplete="off" placeholder="Например, брюки или худи"><button id="clearSearch">Очистить</button><button id="closeSearch">Закрыть</button></div>
  <div class="demo-ribbon">Это дизайн-концепция. Бренд, товары, фото, цены и тарифы доставки — демонстрационные; реальная оплата и СДЭК не подключены.</div>
</div>
<main>
  <section class="hero shell" aria-labelledby="heroTitle">
    <div class="hero-image"><img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&amp;fit=crop&amp;w=1600&amp;q=85" alt="Модель в ярком жёлтом комплекте на фоне голубого неба" fetchpriority="high"></div>
    <div class="hero-copy">
      <div class="small-cap">Цвет — тоже способ говорить</div>
      <div><h1 id="heroTitle">НЕ БУДЬ<br><em>ФОНОМ.</em></h1><p>Вещи для твоего настроения. Миксуй цвета, выбирай свою посадку и носи то, что нравится именно тебе.</p><a class="outline-light" href="#catalog">Выбрать свой образ</a></div>
      <div class="hero-bottom"><div class="hero-mark">SHUM / CLUB</div><div class="hero-note">Ты не обязан<br>вписываться.</div></div>
    </div>
  </section>
  <div class="trustline shell"><span>Найди размер и цвет</span><span>Собери несколько вещей</span><span>Выбери СДЭК и оформи заказ</span></div>
  <section class="catalog-section shell" id="catalog" aria-labelledby="catalogTitle">
    <div class="catalog-heading reveal"><h2 id="catalogTitle" class="section-title">НОСИ<br>ПО-СВОЕМУ</h2><p class="catalog-lead">Хочешь спокойнее? Пожалуйста. Хочешь ярче? Ещё лучше. Вся коллекция в одном месте — с удобным выбором размера и цвета.</p></div>
    <div class="catalog-layout">
      <aside class="filters" id="filters" aria-label="Фильтры товаров">
        <div class="filter-mobile-head" style="display:none"><strong>ФИЛЬТРЫ</strong><button class="close-btn" id="closeFilters">Закрыть</button></div>
        <div class="filter-group"><h3 class="filter-title">Что ищешь</h3><div id="categoryFilters"></div></div>
        <div class="filter-group"><h3 class="filter-title">Размер</h3><div id="sizeFilters" class="size-options"></div></div>
        <div class="filter-group"><h3 class="filter-title">Цвет</h3><div id="colorFilters" class="color-options"></div></div>
        <div class="filter-group"><h3 class="filter-title">Цена <span class="filter-count" id="priceMaxLabel"></span></h3><div class="price-labels"><span>0 ₽</span><span id="rangeTopLabel"></span></div><input class="range-input" id="priceRange" type="range" min="0" max="40000" step="1000" value="40000" aria-label="Максимальная цена"><p class="filter-note">Показать товары до выбранной цены</p></div>
        <div class="filters-bottom"><button class="link-btn" id="resetFilters">Сбросить фильтры</button></div>
      </aside>
      <div class="catalog-content"><div class="catalog-tools"><button class="mobile-filter-btn" id="mobileFilters" aria-expanded="false">Фильтры</button><span class="catalog-meta" id="resultCount" aria-live="polite">Загрузка товаров...</span><div class="sort-area"><span>Порядок:</span><div id="sortSelect" class="select"></div></div></div><div class="products" id="products" aria-live="polite"></div><button class="show-more" id="showMore" hidden>Показать ещё</button></div>
    </div>
  </section>
  <section class="editorial shell" id="manifesto" aria-labelledby="manifestoTitle">
    <div class="editorial-copy reveal"><div class="small-cap">О концепции</div><div><h2 id="manifestoTitle">У КАЖДОГО<br>СВОЙ РИТМ.</h2><p>SHUM — вымышленный бренд для демонстрации второго направления дизайна: более открытого, насыщенного и живого. Вместо тишины и монохрома — свобода экспериментировать со своим образом.</p><a href="#catalog">Найти свою вещь</a></div></div>
    <div class="editorial-image"><img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&amp;fit=crop&amp;w=1250&amp;q=82" loading="lazy" alt="Редакционная фотография модного образа"></div>
  </section>
  <section class="delivery-section shell" id="delivery" aria-labelledby="deliveryTitle">
    <div class="reveal"><h2 id="deliveryTitle">НАШЁЛ.<br>ВЫБРАЛ.<br>ЗАКАЗАЛ.</h2><p>Без регистрации: открой карточку, выбери размер и цвет, добавь в корзину. Промокод, город, пункт выдачи и итоговая сумма — на следующем шаге.</p><p>В этом прототипе СДЭК и платёжная система имитируются на стороне браузера. Никакие деньги и заказы не отправляются.</p></div>
    <div class="details-list reveal"><article><strong>Размер имеет значение</strong><p>Выбирай из доступных размеров каждого товара.</p></article><article><strong>Корзина без суеты</strong><p>Меняй количество, удаляй вещи, применяй промокод.</p></article><article><strong>Доставка СДЭК</strong><p>Тестовый выбор города и пункта выдачи с пересчётом суммы.</p></article><article><strong>Оформление онлайн</strong><p>Демо-форма с проверкой данных и понятным завершением.</p></article></div>
  </section>
</main>
<footer id="contacts" class="footer"><div class="shell"><div class="footer-upper"><div><div class="footer-brand">SHUM.</div><p class="footer-brand-sub">Не теряйся в толпе. Демо-бренд.</p></div><div class="footer-col"><h3>Разделы</h3><a href="#catalog">Каталог</a><a href="#manifesto">О концепции</a><a href="#delivery">Доставка и оплата</a><a href="#top">Наверх</a></div><div class="footer-col"><h3>Протестировать</h3><button id="openAdmin">Демо-админка</button><button data-open-search>Поиск</button><button id="footerCart">Корзина</button></div></div><div class="footer-bottom"><span>© 2026 SHUM / COLOR CLUB · Концепция интернет-магазина, не действующий бренд</span><span>Фото: <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a> · Для настоящего магазина нужны фотографии и данные заказчика.</span></div></div></footer>
<div class="overlay" id="overlay" hidden><div class="panel" id="panel" role="dialog" aria-modal="true" aria-label="Панель магазина"><div class="panel-head"><h2 id="panelTitle"></h2><button id="closePanel" class="close-btn" aria-label="Закрыть панель">Закрыть</button></div><div class="panel-body" id="panelBody"></div></div></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>

  'use strict';
  const PHOTO = id => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=920&q=82`;
  const seed = [
    ['Комплект «Солнце»','Комплекты',12900,'photo-1515886657613-9f3515b0c78f','Жёлтый,Чёрный','XS,S,M,L','Хит коллекции', 'Удобный комплект для дней, когда хочется выделяться.'],
    ['Жакет «Контур»','Верхняя одежда',18900,'photo-1701450707728-dc66fd42da83','Чёрный,Графит','S,M,L,XL','', 'Жакет прямого силуэта для выразительного многослойного образа.'],
    ['Куртка «Тень»','Верхняя одежда',21500,'photo-1630046108712-43875343a84f','Чёрный,Молочный','XS,S,M,L','Новинка', 'Лаконичная куртка с объёмной линией плеча.'],
    ['Лонгслив «Такт»','Трикотаж',7900,'photo-1616570993271-d9d56f8933a7','Чёрный,Графит,Молочный','XS,S,M,L,XL','', 'Базовый лонгслив для повседневных сочетаний.'],
    ['Топ «Пауза»','Трикотаж',6400,'photo-1628038341191-8e7448fc8209','Чёрный,Молочный','XS,S,M,L','', 'Простой силуэт и мягкое прилегание.'],
    ['Брюки «Объём»','Брюки',14800,'photo-1539109136881-3be0616acf4b','Чёрный,Графит','S,M,L,XL','Новинка', 'Широкие брюки с мягкой линией складок.'],
    ['Рубашка «Поле»','Рубашки',11900,'photo-1551938032-eb735ff04051','Молочный,Чёрный','XS,S,M,L','', 'Свободная рубашка для многослойного гардероба.'],
    ['Пиджак «Архив»','Верхняя одежда',27900,'photo-1529139574466-a303027c1d8b','Чёрный,Графит','S,M,L,XL','', 'Пиджак с точной архитектурой силуэта.'],
    ['Футболка «База»','Футболки',4900,'photo-1621694691319-0d74e2d9a79c','Чёрный,Молочный,Графит','XS,S,M,L,XL','', 'Лаконичная футболка свободной посадки.'],
    ['Платье «Тишина»','Платья',15900,'photo-1541130292430-a832637ddc0d','Чёрный,Молочный','XS,S,M,L','Новинка', 'Струящийся силуэт для спокойного выразительного образа.'],
    ['Бомбер «Облако»','Верхняя одежда',24500,'photo-1554412933-514a83d2f3c8','Чёрный,Графит','XS,S,M,L,XL','', 'Объёмная форма и лаконичная отделка.'],
    ['Брюки «Вектор»','Брюки',12900,'photo-1483985988355-763728e1935b','Чёрный,Молочный','XS,S,M,L,XL','', 'Повседневные брюки со свободным кроем.'],
    ['Туника «Слой»','Трикотаж',8900,'photo-1525507119028-ed4c629a60a3','Чёрный,Молочный','S,M,L','', 'Удлинённая форма для многослойных сочетаний.'],
    ['Рубашка «Свет»','Рубашки',10900,'photo-1490481651871-ab68de25d43d','Молочный,Графит','XS,S,M,L','', 'Рубашка с мягкой структурой ткани.'],
    ['Топ «Ритм»','Трикотаж',6900,'photo-1533836683024-78f6568c4ce1','Чёрный,Графит','XS,S,M,L','', 'Комфортный топ для ежедневного гардероба.'],
    ['Пальто «Пластика»','Верхняя одежда',35900,'photo-1487222477894-8943e31ef7b2','Графит,Чёрный','S,M,L','', 'Выразительный объём и сдержанная отделка.']
  ];
  const COLOR_MAP = {'Чёрный':'#171717','Графит':'#57585a','Молочный':'#e3dfd3','Песочный':'#b9a99b','Жёлтый':'#f7cd19','Красный':'#f64d40','Синий':'#3457eb','Лайм':'#c7ee3f'};
  const SIZE_LIST=['XS','S','M','L','XL','XXL'];
  const fmt = value => Number(value).toLocaleString('ru-RU')+' ₽';
  const escapeHTML = value => String(value??'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const getSaved = (key, fallback) => {try{const raw=localStorage.getItem(key);return raw===null?fallback:JSON.parse(raw)}catch{return fallback}};
  const save = (key,value) => {try{localStorage.setItem(key,JSON.stringify(value))}catch{}};
  const defaults = seed.map((a,i)=>({id:'p'+(i+1),name:a[0],category:a[1],price:a[2],image:PHOTO(a[3]),colors:a[4].split(','),sizes:a[5].split(','),badge:a[6],description:a[7],rank:i}));
  let products=getSaved('shum_demo_products_v1',defaults);
  if(!Array.isArray(products)||!products.length)products=[...defaults];
  let cart=getSaved('shum_demo_cart_v1',[]).filter(item=>products.some(p=>p.id===item.id));
  let orders=getSaved('shum_demo_orders_v1',[]);
  let filters={categories:new Set(),sizes:new Set(),colors:new Set(),max:40000,query:'',sort:'featured'};
  let displayedCount=9, selectedProduct=null,selectedColor=null,selectedSize=null,selectedQty=1, promo='', activePanel='',lastFocus=null,toastTimer;
  const el=id=>document.getElementById(id);
  const byId=id=>products.find(p=>p.id===id);
  const categories=()=>[...new Set(products.map(p=>p.category))];
  const maxPrice=()=>Math.max(40000,Math.ceil(Math.max(0,...products.map(p=>p.price))/1000)*1000);
  const productCard=p=>`<article class="product-card reveal"><button class="product-photo" data-product="${escapeHTML(p.id)}" aria-label="Подробнее: ${escapeHTML(p.name)}"><img src="${escapeHTML(p.image)}" alt="Фото для концепции: ${escapeHTML(p.name)}" loading="lazy" onerror="this.style.opacity='.2';this.alt='Фото недоступно'"><span class="quick-view">Открыть карточку</span>${p.badge?`<span class="product-badge">${escapeHTML(p.badge)}</span>`:''}</button><div class="product-meta"><button class="product-name" data-product="${escapeHTML(p.id)}">${escapeHTML(p.name)}</button><div class="product-category">${escapeHTML(p.category)}</div><div class="product-bottom"><span class="product-price">${fmt(p.price)}</span><span class="mini-swatches" aria-label="Цвета: ${escapeHTML(p.colors.join(', '))}">${p.colors.map(c=>`<i style="background:${COLOR_MAP[c]||'#aaa'}" title="${escapeHTML(c)}"></i>`).join('')}</span></div></div></article>`;
